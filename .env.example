# ==========================================
# API KEYS (Required)
# ==========================================

# 1. Google Gemini (Free at https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Hugging Face (Free at https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY="your_huggingface_api_key_here"

# 3. Pinterest App Credentials (from developer.pinterest.com)
PINTEREST_APP_ID="your_pinterest_app_id_here"
PINTEREST_APP_SECRET="your_pinterest_app_secret_here"

# ==========================================
# GENERATED TOKENS (Generated by setup_pinterest_auth.py)
# ==========================================
PINTEREST_ACCESS_TOKEN=""
PINTEREST_REFRESH_TOKEN=""

# ==========================================
# BOARD MAPPING
# Map your category names to Pinterest Board IDs
# ==========================================
BOARD_ID_STEM="your_board_id_here"
BOARD_ID_MONTESSORI="your_board_id_here"
BOARD_ID_CRAFTS="your_board_id_here"
